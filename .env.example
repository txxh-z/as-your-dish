# ===== LLM provider selection =====
# anthropic | openai | gemini
LLM_PROVIDER=anthropic
# leave empty to use the adapter's defaultModel
LLM_MODEL=

# ===== LLM keys (one of the following is required, matching LLM_PROVIDER) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Auth (phase 3+) =====
# generate with: openssl rand -hex 32
JWT_SECRET=

# ===== Image search (phase 5) =====
UNSPLASH_ACCESS_KEY=

# ===== Server =====
PORT=3000
NODE_ENV=development
# comma-separated browser origins allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Database =====
# libsql local file format. Backend config normalizes relative file paths from project root.
DATABASE_URL=file:./backend/dev.db

# ===== Frontend =====
# Empty = same-origin /api (works with Vite proxy locally and Vercel rewrites in production).
# Set to a backend origin such as https://as-your-dish-api.fly.dev for direct API calls.
VITE_API_BASE_URL=

# ===== Cost guards =====
# per-user monthly LLM call quota when using server key.
MONTHLY_QUOTA_PER_USER=30
# Enable anonymous demo guard: 1 = anonymous IPs get 3 non-cached LLM calls/day.
DEMO_MODE=0

# ===== Debug / diagnostics =====
# Set LLM_DEBUG=1 to dump raw LLM responses (stop_reason, usage, content
# blocks, parse-failure issues) to stderr from the adapter. Default empty
# = silent. Toggle on when diagnosing schema-validation failures.
LLM_DEBUG=

# deps
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
.vercel/

# env (secrets)
.env
.env.local
.env.*.local

# database files (privacy: may contain user health data)
*.sqlite
*.sqlite-journal
*.db
*.db-journal

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# coverage
coverage/
.nyc_output/

# editor
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS
.DS_Store
Thumbs.db

# test fixtures: keep expected.json, ignore real menu photos
backend/tests/fixtures/*.jpg
backend/tests/fixtures/*.jpeg
backend/tests/fixtures/*.png
!backend/tests/fixtures/*.expected.json

# debug snapshots (the dump script is tracked, its output is not)
backend/scripts/__schema-snapshot__.json

# runtime image cache
backend/public/dish-images/

# local backup of pre-compressed example images (kept out of the image)
backend/examples/.original/

# internal author notes / non-public documentation
PROJECT_PLAN.md

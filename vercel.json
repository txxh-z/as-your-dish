{
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w shared && npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://as-your-dish-api.fly.dev/api/:path*"
    },
    {
      "source": "/dish-images/:path*",
      "destination": "https://as-your-dish-api.fly.dev/dish-images/:path*"
    }
  ]
}
